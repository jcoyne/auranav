{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chartplotter.local/schema/tile-metadata.schema.json",
  "title": "AuraNav chart package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "name",
    "generatedAt",
    "source",
    "bounds",
    "depth",
    "tileSets",
    "cells"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "product", "downloadUrl", "retrievedAt", "userAgreementPath"],
      "properties": {
        "publisher": { "const": "NOAA Office of Coast Survey" },
        "product": { "const": "NOAA ENC" },
        "downloadUrl": { "type": "string", "format": "uri" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "userAgreementPath": { "type": "string", "minLength": 1 }
      }
    },
    "bounds": { "$ref": "#/$defs/bounds" },
    "depth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storedUnit", "displayUnit", "verticalDatums"],
      "properties": {
        "storedUnit": { "const": "metre" },
        "displayUnit": { "enum": ["metre", "foot", "fathom"] },
        "verticalDatums": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tileSets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "format", "url", "minZoom", "maxZoom", "layers"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "cellName": { "type": "string", "pattern": "^US[1-6][A-Z0-9]{5}$" },
          "format": { "enum": ["pmtiles", "mvt"] },
          "url": { "type": "string", "minLength": 1 },
          "minZoom": { "type": "integer", "minimum": 0, "maximum": 24 },
          "maxZoom": { "type": "integer", "minimum": 0, "maximum": 24 },
          "layers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": [
              "coverage", "coastline", "depth-area", "depth-contour", "sounding", "light",
              "land-area", "land-label", "water-label", "buoy", "danger", "harbour-facility", "anchorage",
              "restricted-area", "restricted-area-edge", "cable", "shoreline-structure", "mooring", "landmark"
            ] }
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "edition", "updateNumber", "issueDate", "updateApplicationDate", "usageBand", "compilationScale", "bounds"],
        "properties": {
          "name": { "type": "string", "pattern": "^US[1-6][A-Z0-9]{5}$" },
          "edition": { "type": "integer", "minimum": 1 },
          "updateNumber": { "type": "integer", "minimum": 0 },
          "issueDate": { "type": "string", "format": "date" },
          "updateApplicationDate": { "type": "string", "format": "date" },
          "usageBand": { "type": "integer", "minimum": 1, "maximum": 6 },
          "compilationScale": { "type": "integer", "minimum": 1 },
          "verticalDatum": { "type": "string", "minLength": 1 },
          "bounds": { "$ref": "#/$defs/bounds" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "cells": { "type": "array", "minItems": 2 } },
        "required": ["cells"]
      },
      "then": {
        "properties": {
          "tileSets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "cellName": {} },
              "required": ["cellName"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "bounds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "items": false
    }
  }
}
